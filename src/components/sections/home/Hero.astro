---
import { SplitHeadline } from "@/components/react/SplitHeadline";
import { LifeField } from "@/components/react/LifeField";

const rustboxHref = "https://rustbox.sh";

const headlineLines = [
	[{ t: "AI" }, { t: "you" }, { t: "don't" }, { t: "have" }, { t: "to" }],
	[{ t: "take" }, { t: "on" }, { t: "faith.", accent: true }],
];
---

<section
	aria-label="Intro"
	class="relative flex w-full flex-col justify-center overflow-hidden bg-background pb-16 pt-32 tablet:pt-36 laptop:min-h-[76dvh] laptop:pb-20"
	data-reveal
>
	<!-- Life is texture: masked away from the centre so it never competes with
	     the headline or the terminal. Cells survive only at the edges. -->
	<div
		class="pointer-events-none absolute inset-0 z-0"
		style="-webkit-mask-image: radial-gradient(115% 85% at 50% 50%, transparent 38%, #000 88%); mask-image: radial-gradient(115% 85% at 50% 50%, transparent 38%, #000 88%);"
	>
		<LifeField client:visible />
	</div>

	<div class="relative z-20 mx-auto w-full max-w-site px-6 tablet:px-8">
		<div class="grid grid-cols-1 items-center gap-12 laptop:grid-cols-12 laptop:gap-10">
			<div class="flex flex-col items-start gap-6 text-left laptop:col-span-7">
				<p class="font-mono text-[12px] uppercase tracking-[0.14em] text-muted-foreground">
					Applied AI research, shipped as products
				</p>

				<SplitHeadline
					client:load
					lines={headlineLines}
					className="font-display text-foreground"
					accentClassName="text-signature-deep"
					style={{
						fontWeight: 500,
						letterSpacing: "-0.045em",
						lineHeight: 1.0,
						fontSize: "clamp(2.5rem, 5.6vw, 4.5rem)",
						textAlign: "left",
					}}
				/>

				<p class="max-w-[54ch] text-body-lg leading-[30px] text-foreground/70">
					We build AI for the high-stakes moments - untrusted code, grading at
					scale, agents on the loose - and back every one with proof you can
					check, not promises.
				</p>

				<div class="flex flex-col gap-3 pt-1 tablet:flex-row tablet:items-center">
					<a
						href={rustboxHref}
						class="group inline-flex h-12 min-h-[48px] items-center justify-center gap-2 rounded-lg bg-primary px-7 text-base font-bold text-primary-foreground transition-colors duration-150 hover:bg-signature-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-background"
					>
						Open Rustbox
						<svg
							class="size-[18px] transition-transform duration-150 group-hover:translate-x-0.5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M5 12h14M13 6l6 6-6 6"></path>
						</svg>
					</a>
					<a
						href="#proof"
						class="inline-flex h-12 min-h-[48px] items-center justify-center gap-2 rounded-lg border border-foreground/20 px-7 text-base font-semibold text-foreground transition-colors duration-150 hover:bg-foreground/[0.05] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-signature focus-visible:ring-offset-2 focus-visible:ring-offset-background"
					>
						See the proof
					</a>
				</div>
			</div>

			<div class="laptop:col-span-5" data-reveal style="--reveal-delay: 0.08s;">
				<figure
					class="w-full max-w-[560px] overflow-hidden rounded-xl bg-tile font-mono text-[12.5px] leading-[1.55] text-on-tile/85 shadow-[0_18px_40px_-24px_oklch(0.165_0.008_62_/_0.45)]"
				>
					<figcaption
						class="flex items-center justify-between border-b border-on-tile/10 px-4 py-2.5"
					>
						<span class="flex items-center gap-1.5" aria-hidden="true">
							<span class="size-2.5 rounded-full bg-on-tile/15"></span>
							<span class="size-2.5 rounded-full bg-on-tile/15"></span>
							<span class="size-2.5 rounded-full bg-on-tile/15"></span>
						</span>
						<span class="text-[11px] uppercase tracking-[0.14em] text-on-tile/45">orkait · verdicts</span>
						<span class="text-[10px] uppercase tracking-[0.12em] text-on-tile/35" aria-hidden="true">
							3 surfaces
						</span>
					</figcaption>
					<div class="overflow-x-auto px-4 pb-1 pt-3">
						<div class="pb-1 text-on-tile/45"># every claim below returns a verdict you can check.</div>

						<div class="flex flex-col gap-0.5 border-t border-on-tile/[0.07] py-3">
							<div class="flex items-center gap-2 pb-1">
								<span class="text-[10px] uppercase tracking-[0.14em] text-on-tile/40">agent code</span>
								<span class="inline-flex items-center rounded-full bg-signature px-1.5 py-px text-[9px] font-bold uppercase tracking-[0.1em] text-on-signature">live</span>
								<span class="h-px flex-1 bg-on-tile/[0.07]" aria-hidden="true"></span>
							</div>
							<div><span class="text-on-tile/45">$</span> curl rustbox.sh/api/submit -d '&#123;"code":"&lt;agent_patch&gt;"&#125;'</div>
							<div><span class="font-bold text-signature-soft">● AC Accepted</span> <span class="text-on-tile/55">· kernel isolation · syscall trace · exit 0</span></div>
						</div>

						<div class="flex flex-col gap-0.5 border-t border-on-tile/[0.07] py-3">
							<div class="flex items-center gap-2 pb-1">
								<span class="text-[10px] uppercase tracking-[0.14em] text-on-tile/40">model weights</span>
								<span class="h-px flex-1 bg-on-tile/[0.07]" aria-hidden="true"></span>
							</div>
							<div><span class="text-on-tile/45">$</span> python -m orka verify model.orka</div>
							<div><span class="font-bold text-signature-soft">● ~2 bits/weight</span> <span class="text-on-tile/55">· perplexity vs fp16, measured</span></div>
						</div>

						<div class="flex flex-col gap-0.5 border-t border-on-tile/[0.07] py-3">
							<div class="flex items-center gap-2 pb-1">
								<span class="text-[10px] uppercase tracking-[0.14em] text-on-tile/40">agent memory</span>
								<span class="h-px flex-1 bg-on-tile/[0.07]" aria-hidden="true"></span>
							</div>
							<div><span class="text-on-tile/45">&gt;</span> SIMILAR TO "paris travel" LIMIT 10</div>
							<div><span class="font-bold text-signature-soft">● 10 memories</span> <span class="text-on-tile/55">· 127 µs · scores attached</span><span class="term-cursor on ml-1" aria-hidden="true"></span></div>
						</div>
					</div>
				</figure>
				<p class="mt-3 font-mono text-[11px] uppercase tracking-[0.12em] text-muted-foreground">
					Real commands ·
					<a
						href={rustboxHref}
						class="text-foreground/75 underline underline-offset-4 transition-colors duration-150 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-signature"
					>rustbox.sh</a>
					·
					<a
						href="https://github.com/orkait"
						class="text-foreground/75 underline underline-offset-4 transition-colors duration-150 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-signature"
					>github.com/orkait</a>
				</p>
			</div>
		</div>
	</div>
</section>
