---
import { routes } from "@/lib/data/nav";
---

<section class="w-full bg-signature-deep text-on-signature" data-reveal>
	<div
		class="mx-auto flex w-full max-w-site flex-col gap-8 px-6 py-24 tablet:px-8 tablet:py-28 laptop:flex-row laptop:items-center laptop:justify-between laptop:gap-16"
	>
		<div class="flex max-w-[52ch] flex-col gap-4">
			<h2
				class="max-w-[20ch] font-display text-[clamp(1.75rem,3.2vw,2.75rem)] font-semibold leading-[1.1] tracking-[-0.02em]"
			>
				Have a hard problem worth shipping?
			</h2>
			<p class="text-body-lg leading-[30px] text-on-signature/85">
				We take on selective research partnerships when there is a path to a
				real system.
			</p>
		</div>
		<a
			href={routes.contact}
			class="group inline-flex h-[52px] min-h-[48px] shrink-0 items-center justify-center gap-2 rounded-lg bg-tile px-8 text-base font-bold text-on-tile transition-colors duration-150 hover:bg-tile/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-on-signature focus-visible:ring-offset-2 focus-visible:ring-offset-signature max-laptop:w-full"
		>
			Get in touch
			<svg
				class="size-[18px] transition-transform duration-150 group-hover:translate-x-0.5"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M5 12h14M13 6l6 6-6 6"></path>
			</svg>
		</a>
	</div>
</section>
