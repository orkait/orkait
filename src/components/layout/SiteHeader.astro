---
import { routes, headerNav, headerCtas } from "@/lib/data/nav";
import { cn } from "@/lib/utils";

interface Props {
	overlap?: boolean;
}

const { overlap = false } = Astro.props;

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header
	data-site-header
	class={cn(
		"pointer-events-none sticky top-5 z-50 mt-6 w-full px-8 tablet:mt-10 mobile:max-tablet:top-4 mobile:max-tablet:mt-4 mobile:max-tablet:px-4",
		overlap && "-mb-28 mobile:max-tablet:-mb-22",
	)}
>
	<div
		class="pointer-events-auto mx-auto flex h-16 w-full max-w-5xl items-center justify-between gap-6 rounded-full border border-on-tile/10 bg-tile pl-6 pr-3 text-on-tile shadow-[0_8px_24px_oklch(0.145_0_0_/_0.25)] tablet:h-18 tablet:pl-7"
	>
		<a
			href={routes.home}
			class="flex shrink-0 items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-signature focus-visible:ring-offset-2 focus-visible:ring-offset-tile"
			aria-label="Orkait home"
		>
			<img src="/data/brand/orkait.svg" alt="" width="28" height="28" class="size-7 invert" />
			<span class="text-body-lg font-medium tracking-tight">Orkait</span>
		</a>

		<nav aria-label="Primary" class="flex items-center gap-9 max-laptop:hidden">
			{
				headerNav.map((link) => (
					<a
						href={link.href}
						data-nav-link
						aria-current={isActive(link.href) ? "page" : undefined}
						class="text-body font-medium text-on-tile/70 underline-offset-8 transition-colors duration-150 hover:text-on-tile focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-signature focus-visible:ring-offset-2 focus-visible:ring-offset-tile aria-[current=page]:text-on-tile aria-[current=page]:underline"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2.5">
			<a
				href={headerCtas.rustbox.href}
				target="_blank"
				rel="noopener"
				data-cta="rustbox"
				class="inline-flex h-11 min-h-[44px] items-center justify-center rounded-full bg-primary px-5 text-sm font-bold text-primary-foreground transition-colors duration-150 hover:bg-signature-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-on-tile focus-visible:ring-offset-2 focus-visible:ring-offset-tile max-laptop:hidden"
			>
				{headerCtas.rustbox.label}
			</a>
			<a
				href={headerCtas.contact.href}
				data-cta="contact"
				class="inline-flex h-11 min-h-[44px] items-center justify-center rounded-full border border-on-tile/25 px-5 text-sm font-semibold text-on-tile transition-colors duration-150 hover:bg-on-tile/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-signature focus-visible:ring-offset-2 focus-visible:ring-offset-tile mobile:max-tablet:h-11 mobile:max-tablet:px-4 mobile:max-tablet:text-sm"
			>
				{headerCtas.contact.label}
			</a>
			<button
				popovertarget="mobile-nav"
				data-menu-btn
				class="hidden size-12 items-center justify-center rounded-full text-on-tile max-laptop:inline-flex mobile:max-tablet:size-11"
				aria-label="Open menu"
			>
				<svg
					width="28"
					height="28"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<line x1="3.5" y1="6.5" x2="20.5" y2="6.5"></line>
					<line x1="3.5" y1="12" x2="20.5" y2="12"></line>
					<line x1="3.5" y1="17.5" x2="20.5" y2="17.5"></line>
				</svg>
			</button>
		</div>
	</div>
</header>

<div
	id="mobile-nav"
	popover
	class="popover-panel pointer-events-auto fixed inset-x-0 top-24 m-0 mx-auto rounded-3xl border border-on-tile/10 bg-tile p-4 text-on-tile backdrop:bg-foreground/40 laptop:hidden"
>
	<nav aria-label="Mobile" class="flex flex-col">
		{
			headerNav.map((link) => (
				<a
					href={link.href}
					aria-current={isActive(link.href) ? "page" : undefined}
					class="rounded-2xl px-4 py-3 text-body font-medium text-on-tile/80 transition-colors duration-150 hover:bg-on-tile/10 hover:text-on-tile aria-[current=page]:text-signature-soft"
				>
					{link.label}
				</a>
			))
		}
	</nav>
	<div class="mt-3 flex flex-col gap-2 border-t border-on-tile/10 pt-3">
		<a
			href={headerCtas.rustbox.href}
			target="_blank"
			rel="noopener"
			class="inline-flex h-12 min-h-[48px] w-full items-center justify-center rounded-full bg-primary text-base font-bold text-primary-foreground transition-colors duration-150 hover:bg-signature-hover"
		>
			{headerCtas.rustbox.label}
		</a>
		<a
			href={headerCtas.contact.href}
			class="inline-flex h-12 min-h-[48px] w-full items-center justify-center rounded-full border border-on-tile/25 text-base font-semibold text-on-tile transition-colors duration-150 hover:bg-on-tile/10"
		>
			{headerCtas.contact.label}
		</a>
	</div>
</div>

<script>
	import { initHeader } from "@/lib/client/header";
	initHeader();
	document.addEventListener("astro:page-load", () => initHeader());
</script>
